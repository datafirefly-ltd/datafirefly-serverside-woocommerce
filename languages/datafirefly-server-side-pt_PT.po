#. Plugin Name of the plugin
#: datafirefly-server-side.php
msgid "DataFirefly Server-Side"
msgstr ""

#. Description of the plugin
#: datafirefly-server-side.php
msgid "Complete WooCommerce tracking: client + server, full-funnel, deduplicated, GDPR-aware, reliable. One key configures everything; no destination credentials ever reach the browser."
msgstr "Acompanhamento completo do WooCommerce: navegador + servidor, todo o funil, sem duplicados, atento ao RGPD e fiável. Uma só chave configura tudo; nenhuma credencial de destino chega alguma vez ao navegador."

