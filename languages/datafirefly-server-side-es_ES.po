#. Plugin Name of the plugin
#: datafirefly-server-side.php
msgid "DataFirefly Server-Side"
msgstr ""

#. Description of the plugin
#: datafirefly-server-side.php
msgid "Complete WooCommerce tracking: client + server, full-funnel, deduplicated, GDPR-aware, reliable. One key configures everything; no destination credentials ever reach the browser."
msgstr "Seguimiento completo de WooCommerce: navegador + servidor, todo el embudo, sin duplicados, atento al RGPD y fiable. Una sola clave lo configura todo; ninguna credencial de destino llega nunca al navegador."

