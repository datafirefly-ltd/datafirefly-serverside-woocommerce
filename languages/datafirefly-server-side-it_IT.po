#. Plugin Name of the plugin
#: datafirefly-server-side.php
msgid "DataFirefly Server-Side"
msgstr ""

#. Description of the plugin
#: datafirefly-server-side.php
msgid "Complete WooCommerce tracking: client + server, full-funnel, deduplicated, GDPR-aware, reliable. One key configures everything; no destination credentials ever reach the browser."
msgstr "Tracciamento WooCommerce completo: browser + server, intero funnel, deduplicato, attento al GDPR, affidabile. Una sola chiave configura tutto; nessuna credenziale di destinazione raggiunge mai il browser."

